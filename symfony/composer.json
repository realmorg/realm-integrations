{
    "name": "realmorg/realm-symfony",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/dotenv": "8.1.*",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "allow-plugins": { "symfony/runtime": true },
        "sort-packages": true
    }
}
